# Copy to .env.local. Local mode needs only the first block.

# Postgres. localhost/127.0.0.1 uses node-postgres (docker compose up -d); any other host uses Neon.
DATABASE_URL=postgres://seatmap:seatmap@localhost:5432/seatmap
# Optional: separate database for `pnpm test:neon` (real concurrent connections)
DATABASE_URL_TEST=postgres://seatmap:seatmap@localhost:5432/seatmap_test

# "local" stores uploads/geometry under public/local-blob (no Vercel Blob token needed).
# Remove it and set BLOB_READ_WRITE_TOKEN to use Vercel Blob.
NEXT_PUBLIC_BLOB_MODE=local
# BLOB_READ_WRITE_TOKEN=

# Seed: required to seed a non-local database
# SEED_CONFIRM=
